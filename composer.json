{
    "name": "jonathan-boada/app-salon_php_mvc_js_sass",
    "description": "Proyecto PHP 8, MVC, SQL, SASS, Gulp",
    "type": "project",
    "autoload": {
        "psr-4": {
            "MVC\\": "./",
            "Controllers\\": "./controllers",
            "Model\\": "./models",
            "Classes\\": "./classes",
            "Interfaces\\": "./interfaces",
            "Repositories\\": "./repositories",
            "Services\\": "./services"
        }
    },
    "authors": [
        {
            "name": "Jonathan Boada",
            "email": "jonathanboada1@gmail.com"
        }
    ],
    "require": {
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit --colors=never",
        "migrate:status": "php database/migrador.php status",
        "migrate:up": "php database/migrador.php up",
        "migrate:down": "php database/migrador.php down",
        "db:backup": "php scripts/backup_db.php",
        "db:restore": "php scripts/restore_db.php"
    }
}
