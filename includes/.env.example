# ============================================================================
# Plantilla de Variables de Entorno — AppSalon (PHP 8.2 + MySQL 8.0)
# Copie este archivo a `includes/.env` y ajuste los valores según su entorno.
# NUNCA versione `includes/.env` ni almacene credenciales reales en Git.
# ============================================================================

# 1. Entorno, URL Base y Zona Horaria
APP_ENV=local
APP_URL=http://localhost:8085
APP_TIMEZONE=America/Guayaquil

# 2. Conexión a Base de Datos MySQL 8.0 (InnoDB / utf8mb4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=appsalon_mvc

# 3. Configuración de Servidor de Correo SMTP (Confirmaciones, Recuperación y Recordatorios)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=tu_usuario_smtp
EMAIL_PASS=tu_password_smtp
EMAIL_PASSWORD=tu_password_smtp
EMAIL_FROM=no-reply@appsalon.local
EMAIL_FROM_NAME="AppSalon Reservas"

# 4. Notificaciones y Recordatorios de Citas (Fase 6A)
# Horas de anticipación para enviar recordatorios de citas futuras (evaluadas en America/Guayaquil)
NOTIFICACIONES_RECORDATORIO_HORAS=24

# 5. Políticas de Reserva (Fase 4B / Fase 5)
# 1 = exige profesional e intervalo válido en POST /api/citas; 0 = permite modo legado sólo en pruebas específicas
RESERVA_EXIGIR_PROFESIONAL=1

# 6. Pasarela de Pagos y Seguridad de Webhooks (Fase 6C)
# Proveedor activo: 'mock' (sandbox determinista; no realiza cargos reales)
PAYMENT_GATEWAY_PROVIDER=mock
# Secreto HMAC-SHA256 para verificar la firma criptográfica de notificaciones webhook (X-Mock-Signature)
PAYMENT_WEBHOOK_SECRET=reemplazar_con_secreto_hmac_hex_de_al_menos_32_bytes
